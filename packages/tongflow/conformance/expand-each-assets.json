            },
            {
                "type": "plugin_progress",
                "nodeId": "o",
                "message": "batch 3/3"
            },
            {
                "type": "node_completed",
                "nodeId": "o"
            },
            {
                "type": "workflow_completed",
                "status": "success",
                "errors": []
            }
        ]
    }
}
