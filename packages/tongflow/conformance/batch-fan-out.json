{
    "name": "batch-fan-out",
    "description": "A text node with three items fans a batchOn field out into three calls; outputs merge in batch order.",
    "workflow": {
        "name": "batch-fan-out",
        "version": "1.0",
        "exportedAt": "2026-01-01T00:00:00.000Z",
        "inputs": [],
