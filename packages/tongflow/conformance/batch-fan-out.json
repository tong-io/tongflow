                    },
                    "userPrompt": {
                        "kind": "config",
                        "value": "shout"
                    }
                },
                "batchField": "text",
                "outputs": [
                    {
                        "sourceField": "text",
                        "nodeType": "textNode",
                        "dataField": "texts",
                        "expandEach": false,
                        "downstreamDataNodeId": "out"
                    }
                ],
                "dependencies": ["in"],
                "level": 1
            }
        ],
        "executionLevels": [["g"]],
        "dataNodeEdges": [
            {
                "source": "in",
                "target": "g"
            },
            {
                "source": "g",
                "target": "out"
            }
        ]
    },
    "plugins": {
        "tongflow-api-fake-upper": [
            {
                "op": "format",
                "field": "text",
                "template": "{userPrompt}:{text}"
            }
        ]
    },
    "expected": {
