{
    "name": "failure-batch-item",
    "description": "One failing item of a batch fan-out fails the node with a batch-item suffix.",
    "workflow": {
        "name": "failure-batch-item",
        "version": "1.0",
        "exportedAt": "2026-01-01T00:00:00.000Z",
        "inputs": [],
        "outputs": [
            {
                "name": "output_out",
                "type": "text",
                "nodeId": "out",
                "field": "texts"
            }
        ],
        "dataNodes": [
            {
                "id": "in",
                "type": "textNode",
                "dataType": "text",
                "isInput": false,
                "staticData": {
                    "texts": ["ok", "bad", "later"]
                },
                "level": 0
            },
            {
                "id": "out",
                "type": "textNode",
                "dataType": "text",
                "isInput": false,
                "level": 2
            }
        ],
        "executableNodes": [
            {
                "id": "g",
                "type": "genTextNode",
                "feature": "gen-text",
                "pluginId": "tongflow-api-fake-picky",
                "bindings": {
                    "text": {
                        "kind": "handle",
                        "sources": [
                            {
                                "fromNodeId": "in",
                                "fromField": "texts"
                            }
                        ],
                        "targetHandle": "in:text",
                        "consumerShape": "scalar"
                    }
                },
                "batchField": "text",
                "outputs": [
                    {
                        "sourceField": "text",
                        "nodeType": "textNode",
                        "dataField": "texts",
                        "expandEach": false,
                        "downstreamDataNodeId": "out"
                    }
                ],
                "dependencies": ["in"],
                "level": 1
            }
        ],
        "executionLevels": [["g"]],
        "dataNodeEdges": [
            {
                "source": "in",
                "target": "g"
            },
            {
                "source": "g",
                "target": "out"
            }
        ]
    },
    "plugins": {
        "tongflow-api-fake-picky": [
            {
                "op": "fail",
                "error": "cannot handle {text}",
                "when": {
                    "field": "text",
                    "equals": "bad"
                }
            },
            {
                "op": "format",
                "field": "text",
                "template": "done:{text}"
            }
        ]
    },
    "expected": {
        "status": "failed",
        "outputs": {},
        "outputsByName": {},
        "errors": ["Node g failed: cannot handle bad (batch item 2/3)"],
        "failures": [
            {
                "nodeId": "g",
                "summary": "cannot handle bad (batch item 2/3)"
            }
        ],
        "events": [
            {
                "type": "workflow_started",
                "totalNodes": 1,
                "levels": 1
            },
            {
                "type": "node_started",
                "nodeId": "g",
                "level": 1
            },
            {
                "type": "plugin_progress",
                "nodeId": "g",
                "message": "batch 1/3"
            },
            {
                "type": "plugin_progress",
                "nodeId": "g",
                "message": "batch 2/3"
            },
            {
                "type": "node_failed",
                "nodeId": "g",
                "error": "cannot handle bad (batch item 2/3)"
            },
            {
                "type": "workflow_failed",
                "status": "failed",
                "errors": ["Node g failed: cannot handle bad (batch item 2/3)"]
            }
        ]
    }
}
