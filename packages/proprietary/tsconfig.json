{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "isolatedModules": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"]
}
