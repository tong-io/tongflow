{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenflowFeatureRegistry",
  "type": "object",
  "required": ["features"],
  "properties": {
    "$schema": { "type": "string" },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "function", "processingTime"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "function": { "type": "string", "minLength": 1 },
          "processingTime": { "type": "number" }
        },
        "additionalProperties": false
      }
    },
    "aliases": {
      "type": "object",
      "properties": {
        "canonical": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "labelLookup": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
