{
    "name": "openflow",
    "version": "0.1.0",
    "description": "A multi-modal AIGC studio for building generative AI workflows",
    "author": "tong-io",
    "keywords": [
        "aigc",
        "ai",
        "workflow",
        "multimodal",
        "next.js"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/tong-io/tongflow"
    },
    "homepage": "https://github.com/tong-io/tongflow#readme",
    "license": "AGPL-3.0-only",
    "private": true,
    "pnpm": {
        "onlyBuiltDependencies": [
            "@swc/core",
            "better-sqlite3",
            "cbor-extract",
            "esbuild",
            "protobufjs",
            "sharp"
        ]
    },
    "scripts": {
        "predev": "pnpm gen:abi",
        "dev": "next dev",
        "prebuild": "pnpm gen:abi",
        "build": "next build",
        "build:obfuscated": "next build && node scripts/obfuscate-next-client.mjs",
        "dist:clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "dist:build": "pnpm build:obfuscated && node scripts/prepare-standalone-dist.mjs",
        "start": "next start",
        "modal:setup": "node scripts/modal-setup.mjs",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "lint": "npx biome format --write",
        "lint:check": "npx biome check --error-on-warnings .",
        "typecheck": "tsc --noEmit",
        "gen:abi": "tsx scripts/gen-abi-types.ts",
        "abi:generate": "node scripts/generate-tongflow-abi.mjs",
        "tongflow:publish": "bash scripts/publish-tongflow-pypi.sh",
        "test": "vitest run",
        "verify:plugins": "tsx scripts/verify-plugins-scan.ts"
    },
    "dependencies": {
        "@google/genai": "^1.52.0",
        "@hookform/resolvers": "5.2.2",
        "@openflow/proprietary": "workspace:*",
        "@radix-ui/react-alert-dialog": "1.1.15",
        "@radix-ui/react-checkbox": "1.3.3",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-dropdown-menu": "2.1.16",
        "@radix-ui/react-label": "2.1.8",
        "@radix-ui/react-progress": "1.1.8",
        "@radix-ui/react-select": "2.2.6",
        "@radix-ui/react-separator": "1.1.8",
        "@radix-ui/react-slider": "1.3.6",
        "@radix-ui/react-slot": "1.2.4",
        "@radix-ui/react-switch": "1.2.6",
        "@radix-ui/react-tabs": "1.1.13",
        "@radix-ui/react-tooltip": "1.2.8",
        "@types/three": "^0.184.0",
        "@xyflow/react": "12.10.2",
        "ajv": "8.20.0",
        "better-sqlite3": "12.9.0",
        "chokidar": "^5.0.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "dotenv": "17.4.2",
        "drizzle-orm": "0.45.2",
        "drizzle-zod": "0.8.3",
        "lucide-react": "1.14.0",
        "masonic": "^4.1.0",
        "modal": "^0.7.4",
        "nanoid": "5.1.11",
        "next": "16.2.4",
        "next-intl": "^4.11.0",
        "openai": "^6.36.0",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-hook-form": "7.75.0",
        "react-hot-toast": "2.6.0",
        "server-only": "0.0.1",
        "tailwind-merge": "3.5.0",
        "three": "^0.184.0",
        "uuid": "14.0.0",
        "zod": "4.4.3",
        "zustand": "5.0.13"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.4",
        "@tailwindcss/postcss": "4",
        "@types/better-sqlite3": "^7.6.8",
        "@types/json-schema": "^7.0.15",
        "@types/node": "20.19.13",
        "@types/react": "19",
        "@types/react-dom": "19",
        "drizzle-kit": "0.31.4",
        "javascript-obfuscator": "^4.1.1",
        "json-schema-to-ts": "^3.1.1",
        "tailwindcss": "4",
        "tsx": "^4.20.5",
        "tw-animate-css": "1.3.8",
        "typescript": "5",
        "vitest": "^4.1.5"
    }
}
