{
    "name": "openflow",
    "version": "0.1.0",
    "license": "AGPL-3.0-only",
    "private": true,
    "main": "dist-electron/electron/main.js",
    "pnpm": {
        "onlyBuiltDependencies": [
            "@swc/core",
            "better-sqlite3",
            "cbor-extract",
            "electron",
            "electron-winstaller",
            "esbuild",
            "protobufjs",
            "sharp"
        ]
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:obfuscated": "next build && node scripts/obfuscate-next-client.mjs",
        "dist:clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "dist:build": "pnpm build:obfuscated && node scripts/prepare-standalone-dist.mjs",
        "start": "next start",
        "modal:setup": "node scripts/modal-setup.mjs",
        "desktop:dev": "pnpm desktop:compile && cross-env ELECTRON_DEV=1 concurrently -k -n NEXT,ELECTRON -c blue,magenta \"next dev\" \"electron .\"",
        "desktop:compile": "tsup electron/main.ts electron/preload.ts --format cjs --platform node --target node20 --out-dir dist-electron/electron --clean --external electron",
        "desktop:node:prepare": "node scripts/desktop-prepare-node.mjs",
        "desktop:python:prepare": "node scripts/desktop-prepare-python.mjs",
        "desktop:wheelhouse:prepare": "node scripts/desktop-prepare-wheelhouse.mjs",
        "desktop:build": "pnpm build && pnpm desktop:prepare && pnpm desktop:node:prepare && pnpm desktop:python:prepare && pnpm desktop:wheelhouse:prepare && pnpm desktop:compile && pnpm desktop:pack",
        "desktop:build:unsigned": "pnpm build && pnpm desktop:prepare && pnpm desktop:node:prepare && pnpm desktop:python:prepare && pnpm desktop:wheelhouse:prepare && pnpm desktop:compile && pnpm desktop:pack:unsigned",
        "desktop:prepare": "node scripts/desktop-prepare-standalone.mjs",
        "desktop:pack": "electron-builder --dir",
        "desktop:pack:unsigned": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
        "desktop:dist": "electron-builder",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:studio": "drizzle-kit studio",
        "lint": "npx biome format --write",
        "typecheck": "tsc --noEmit",
        "abi:generate": "node scripts/generate-tongflow-abi.mjs",
        "plugins:sync": "tsx scripts/plugins-sync.ts",
        "tongflow:publish": "bash scripts/publish-tongflow-pypi.sh"
    },
    "dependencies": {
        "@openflow/proprietary": "workspace:*",
        "@google/genai": "^1.47.0",
        "@hookform/resolvers": "5.2.1",
        "@radix-ui/react-alert-dialog": "1.1.15",
        "@radix-ui/react-checkbox": "1.3.3",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-dropdown-menu": "2.1.16",
        "@radix-ui/react-label": "2.1.7",
        "@radix-ui/react-progress": "1.1.7",
        "@radix-ui/react-select": "2.2.6",
        "@radix-ui/react-separator": "1.1.7",
        "@radix-ui/react-slider": "1.3.6",
        "@radix-ui/react-slot": "1.2.3",
        "@radix-ui/react-switch": "1.2.6",
        "@radix-ui/react-tabs": "1.1.13",
        "@radix-ui/react-tooltip": "1.2.8",
        "@types/three": "^0.183.1",
        "@xyflow/react": "12.9.0",
        "better-sqlite3": "12.2.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "dotenv": "17.2.2",
        "drizzle-orm": "0.44.5",
        "drizzle-zod": "0.8.3",
        "lucide-react": "0.544.0",
        "masonic": "^4.1.0",
        "modal": "^0.7.3",
        "nanoid": "5.1.6",
        "next": "15.4.7",
        "next-intl": "^4.6.1",
        "openai": "^6.33.0",
        "react": "19.2.1",
        "react-dom": "19.2.1",
        "react-hook-form": "7.62.0",
        "react-hot-toast": "2.6.0",
        "server-only": "0.0.1",
        "tailwind-merge": "3.3.1",
        "three": "^0.183.2",
        "uuid": "13.0.0",
        "zod": "4.1.8",
        "zustand": "5.0.8"
    },
    "devDependencies": {
        "@biomejs/biome": "2.2.4",
        "@tailwindcss/postcss": "4",
        "@types/better-sqlite3": "^7.6.8",
        "@types/node": "20.19.13",
        "@types/react": "19",
        "@types/react-dom": "19",
        "concurrently": "^9.2.1",
        "cross-env": "^7.0.3",
        "drizzle-kit": "0.31.4",
        "electron": "^37.3.0",
        "electron-builder": "^26.0.12",
        "javascript-obfuscator": "^4.1.1",
        "tailwindcss": "4",
        "tsup": "^8.5.0",
        "tsx": "^4.20.5",
        "tw-animate-css": "1.3.8",
        "typescript": "5"
    }
}
